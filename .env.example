# Copy to .env. Keep the real file and all credentials out of Git.
# The UI starts without these values. Real bulk sends require Notion delivery history.
NOTION_API_KEY=
# Ask the club database owner for the data source ID, URL and integration access.
# Omit these two overrides to use the built-in club database defaults.
# NOTION_DATA_SOURCE_ID=your-data-source-id
# NOTION_DATABASE_URL=https://www.notion.so/your-database-id
NOTION_CURRENT_APPLICATION_PHASE=Winter 2026

# Personalized unsubscribe links require an already deployed website handler.
# Obtain the existing shared signing secret securely; do not invent a new one
# for an existing website, and never put SMTP passwords in this file.
PUBLIC_BASE_URL=https://tum-socialaiclub.de
# NOTION_DATA_SOURCE_ID must be explicitly set above for unsubscribe links.
NOTION_EMAIL_PROPERTY=Email
NOTION_OPT_IN_PROPERTY=Subscribed
NEWSLETTER_TOKEN_SECRET=
# CLI unsubscribe link uses MAILBOT_UNSUBSCRIBE_SECRET; use the same signing secret.
MAILBOT_UNSUBSCRIBE_SECRET=

# Optional local server settings. Keep the server on loopback.
HOST=127.0.0.1
PORT=5177
